{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bukhara-invitation",
  "main": "worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bukhara-invitation",
      "database_id": "780df1e2-9db0-463e-b20f-e5dd2118a39d"
    }
  ]
}
